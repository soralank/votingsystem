# ─── Network Configuration ────────────────────────────────────
# Sepolia Testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Ethereum Mainnet (for production deployment)
# MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# MAINNET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ─── Contract Verification ────────────────────────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ─── Gas Reporting ────────────────────────────────────────────
REPORT_GAS=false
# COINMARKETCAP_API_KEY=YOUR_CMC_KEY  # For USD gas costs

# ─── Deployed Contract Addresses (filled after deployment) ────
# REACT_APP_CONTRACT_ADDRESS=0x...
# REACT_APP_TOKEN_MANAGER_ADDRESS=0x...
# REACT_APP_PAYMASTER_ADDRESS=0x...
# REACT_APP_PROXY_ADDRESS=0x...       # For upgradeable deployment
